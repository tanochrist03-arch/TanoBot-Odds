# ============================================================================
#  TanoBot Odds — modèle de configuration
# ============================================================================
#  Copie ce fichier en « .env » et remplis les valeurs.
#
#      cp .env.example .env
#
#  ⚠️  Le fichier .env ne doit JAMAIS être publié sur GitHub.
#      Il est déjà listé dans .gitignore — ne retire pas cette ligne.
# ============================================================================

# --------------------------------------------------------------- Telegram ---
# Jeton fourni par @BotFather sur Telegram.
#   1. Écris à @BotFather → /newbot → choisis un nom
#   2. Il renvoie un jeton de la forme 123456:ABC-DEF...
#   3. Colle-le ci-dessous
BOT_TOKEN=

# Ton identifiant Telegram numérique (le bot refuse tous les autres).
# Pour le connaître : écris à @userinfobot, il répond avec ton « Id ».
# Plusieurs identifiants possibles, séparés par des virgules.
BOT_ADMIN_IDS=

# ---------------------------------------------------------------- Supabase ---
# Projet Supabase dédié (ne réutilise pas celui d'un autre projet).
# Sans ces valeurs, le bot fonctionne quand même : les données restent
# dans un fichier SQLite local (data/tanobot.db).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ----------------------------------------------------------------- Moteur ---
# Emplacement du projet contenant le moteur d'analyse vérifié.
# Laisse vide si TanoTech-Basket-Analytics est juste à côté de ce projet.
TANOTECH_PATH=

# ----------------------------------------------------------------- Alertes ---
# Scan automatique quotidien : mets 1 pour l'activer.
# Le bot n'envoie un message QUE s'il trouve quelque chose (ou si la source
# tombe trois fois de suite) — jamais de « rien de nouveau ».
ALERTES_ACTIVES=0
HEURE_SCAN=07:00
FUSEAU=Africa/Abidjan

# ------------------------------------------------------------------- Seuils ---
# EV minimum pour retenir un pari (0.05 = 5 % d'espérance).
SEUIL_EV=0.05
# Confiance minimum sur 100.
SEUIL_CONFIANCE=45
# Nombre maximum de paris dans une alerte.
MAX_PARIS_ALERTE=5
